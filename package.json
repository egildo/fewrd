{
  "name": "fewrd",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "description": "Finds what recurs in a string, cuts it loose, and gets you the gist in a few words.",
  "keywords": [
    "text",
    "segmentation",
    "entity-extraction",
    "regex",
    "recipes",
    "gist",
    "fold"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egildo/fewrd.git"
  },
  "homepage": "https://github.com/egildo/fewrd#readme",
  "bugs": "https://github.com/egildo/fewrd/issues",
  "files": [
    "dist",
    "book.schema.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./playground": {
      "types": "./dist/types/playground.d.ts",
      "default": "./dist/playground.js"
    },
    "./book.schema.json": "./book.schema.json"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc",
    "build": "vite build --config vite.lib.ts && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "dev": "vite playground --port 5577 --strictPort"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
