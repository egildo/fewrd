{
  "version": "md-step4",
  "tags": {
    "heading": {
      "search": [
        {
          "from": "hash",
          "forward": [
            {
              "tag": "body",
              "as": "title"
            },
            {
              "tag": [
                "nl",
                "$"
              ]
            }
          ]
        }
      ]
    },
    "list": {
      "search": [
        {
          "from": "item",
          "forward": [
            {
              "tag": "item"
            }
          ]
        },
        {
          "from": "list",
          "forward": [
            {
              "tag": "item"
            }
          ]
        }
      ]
    },
    "item": {
      "search": [
        {
          "from": "dash",
          "forward": [
            {
              "tag": "body",
              "as": "body"
            },
            {
              "tag": [
                "nl",
                "$"
              ]
            }
          ]
        }
      ]
    },
    "para": {
      "search": [
        {
          "from": "line",
          "forward": [
            {
              "tag": [
                "nl",
                "$"
              ]
            }
          ]
        },
        {
          "from": "para",
          "forward": [
            {
              "tag": "line"
            },
            {
              "tag": [
                "nl",
                "$"
              ]
            }
          ]
        }
      ]
    },
    "hash": {
      "rx": "/(?<=%{BOL})%{HASH}/u"
    },
    "dash": {
      "rx": "/(?<=%{BOL})%{DASH}/u"
    },
    "body": {
      "rx": "/(?<=(?:%{BOL})%{OPENER})[^¶]+/u"
    },
    "line": {
      "rx": "/(?<=%{BOL})(?!%{OPENER})[^¶]+/u"
    },
    "nl": {
      "rx": "/¶/u"
    }
  },
  "patterns": {
    "BOL": "^|¶",
    "HASH": "#{1,6} ",
    "DASH": "- ",
    "OPENER": "%{HASH}|%{DASH}"
  }
}