{
  "$schema": "../book.schema.json",
  "version": "it-pa@1",
  "defs": {
    "DATE": "\\d{1,2}[\\/.\\-]\\d{1,2}[\\/.\\-]\\d{4}",
    "LABEL_WORDS": "(?:C\\.?I\\.?G|C\\.?U\\.?P|P\\.?C\\.?F|C\\.?D\\.?R|PROT|PEC|CAP|CAPITOL[OI]|COD|CODICE|FORN|FORNITORE|IVA|EURO|ID|RIF|DEL)\\.?(?![\\p{L}])",
    "CAPS_WORD": "(?!%{LABEL_WORDS})\\p{Lu}(?:[.'&]?\\p{Lu}){2,}\\.?"
  },
  "recipes": [
    {
      "entity": "protocol",
      "anchor": "/\\d{7}(?:\\/\\d{4})?/u",
      "left": [
        { "part": "label", "rx": "/(?:Numero\\s+Protocollo|Protocollo(?:\\s+n[r°]?\\.?)?|Prot\\.?\\s*(?:n[r°]?\\.?)?|Rif\\.?)\\s*:?\\s*/iu" },
        { "part": "channel", "rx": "/(?:PEC|Posta\\s+certificata|Riscontro\\s+a)\\s*[:\\-]\\s*/iu" }
      ],
      "right": [{ "part": "date", "rx": "/\\s*,?\\s*del\\s+%{DATE}/iu" }],
      "requires": ["label"],
      "resolve": "protocol"
    },
    {
      "entity": "cig",
      "anchor": "/[A-Z0-9]{10}/u",
      "left": [{ "part": "label", "rx": "/C\\.?I\\.?G\\.?(?:\\s+(?:derivato|originario|master))?(?:\\s*n\\.)?\\s*[:\\-]?\\s*/iu" }],
      "resolve": "cig"
    },
    {
      "entity": "cup",
      "anchor": "/[A-Z]\\d{2}[A-Z0-9]{12}/u",
      "left": [{ "part": "label", "rx": "/C\\.?\\s?U\\.?\\s?P\\.?(?:\\s+(?:derivato|master))?(?:\\s*n\\.)?\\s*[:\\-]?\\s*/iu" }]
    },
    {
      "entity": "chapter",
      "anchor": "/[A-Z]{2}\\d{2,3}\\.\\d{3,4}/u",
      "left": [{ "part": "label", "rx": "/(?:Capitol[oi]|Cap\\.?)(?:\\s+di\\s+(?:spesa|entrata))?\\s*:?\\s*/iu" }]
    },
    {
      "entity": "amount",
      "anchor": "/\\d+(?:\\.\\d{3})*(?:,\\d{1,2})?/u",
      "left": [{ "part": "label", "rx": "/(?:€|euro)\\s*/iu" }],
      "right": [{ "part": "unit", "rx": "/\\s*€/u" }],
      "resolve": "amount"
    },
    {
      "entity": "date",
      "anchor": "/%{DATE}/u",
      "resolve": "date"
    },
    {
      "entity": "caps",
      "anchor": "/%{CAPS_WORD}(?: %{CAPS_WORD})+/u",
      "weak": true
    },
    {
      "entity": "quotation",
      "anchor": "/con oggetto\\s*:?\\s*/iu",
      "rest": true
    }
  ]
}
